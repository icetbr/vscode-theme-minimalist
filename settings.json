{
    // SUGGESTIONS - haven't been using these lately
    "editor.snippetSuggestions"                   : "none",
    "editor.suggest.localityBonus": true,
    "editor.suggest.showWords"                    : false,
    "editor.suggest.showKeywords": false,

    "javascript.updateImportsOnFileMove.enabled"  : "never",
    "javascript.preferences.quoteStyle"           : "single",
    "javascript.format.semicolons"                : "insert",
    "javascript.suggest.completeFunctionCalls"    : true,  // doesnt work for arrow functions
    "typescript.suggest.completeFunctionCalls"    : true,  // doesnt work for arrow functions
    "editor.inlineSuggest.showToolbar"            : "onHover",
    "editor.codeLens"                             : false, // "4 references" on top of every function
    "editor.stickyScroll.enabled"                 : false,
    "explorer.fileNesting.enabled"                : true,
    "editor.quickSuggestionsDelay"                : 200,
    "editor.tabCompletion"                        : "on"  ,
    "editor.lightbulb.enabled"                    : "off",
    "editor.renderLineHighlight"                  : "gutter",
    "editor.mouseWheelZoom"                       : true,
    "editor.fontFamily"                           : "'Consolas'",   // Source Sans Pro, Fira Code - fontLigatures, DejaVu Sans Mono
    "editor.lineNumbers"                          : "off",
    "editor.wordWrap"                             : "off",
    "editor.formatOnPaste"                        : false,
    "editor.minimap.enabled"                      : false,
    "editor.dragAndDrop"                          : false,
    "editor.hideCursorInOverviewRuler"            : true,
    "editor.overviewRulerBorder"                  : false,
    "editor.foldingHighlight"                     : false,
    "editor.guides.indentation"                   : false,
    "editor.bracketPairColorization.enabled"      : false,
    "editor.gotoLocation.multipleDeclarations"    : "goto",
    "editor.gotoLocation.multipleImplementations" : "goto",
    "editor.gotoLocation.multipleDefinitions"     : "goto",
    "editor.gotoLocation.multipleReferences"      : "goto",
    "editor.gotoLocation.multipleTypeDefinitions" : "goto",

    "explorer.openEditors.visible"                : 1,
    "explorer.confirmDragAndDrop"                 : false,
    "explorer.confirmDelete"                      : false,
    "explorer.autoRevealExclude": {
        "**/node_modules": false,
        "**/bower_components": true
    },

    "window.titleBarStyle"                        : "custom",
    "window.title"                                : "${rootName}",
    "window.newWindowDimensions"                  : "maximized",
    "window.zoomLevel"                            : -1,
    "window.commandCenter"                        : false,
    "workbench.activityBar.location"              : "hidden",
    "workbench.editor.enablePreviewFromQuickOpen" : false,
    "workbench.iconTheme"                         : null,
    "workbench.editor.openPositioning"            : "last",
    "workbench.settings.editor"                   : "json",
    "workbench.tree.renderIndentGuides"           : "none",
    "workbench.editor.decorations.badges"         : false,
    "workbench.editor.decorations.colors"         : false,
    "workbench.editor.wrapTabs"                   : true,
    "workbench.layoutControl.enabled"             : false,
    "workbench.colorTheme"                        : "Minimalist (Purple Object Keys)",

    "debug.console.fontSize"                      : 13,
    "debug.showInlineBreakpointCandidates"        : false,
    "debug.allowBreakpointsEverywhere"            : true,
    "debug.openDebug"                             : "neverOpen",
    "debug.javascript.autoAttachFilter"           : "onlyWithFlag",

    "files.autoSave"                              : "off",
    "files.autoSaveDelay"                         : 180000,
    "files.trimTrailingWhitespace"                : true,
    "files.defaultLanguage"                       : "javascript",
    "files.restoreUndoStack"                      : false,
    "files.insertFinalNewline"                    : true,

    "terminal.integrated.cursorStyle"             : "line",
    "terminal.integrated.tabs.enabled"            : false,
    "terminal.integrated.rightClickBehavior"      : "default",
    "terminal.integrated.defaultProfile.windows"  : "Git Bash",
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",

    "git.openRepositoryInParentFolders"           : "never",
    "git.autoRepositoryDetection"                 : false,
    "git.detectSubmodules"                        : false,
    "git.ignoreSubmodules"                        : true,
    "git.showActionButton"                        : { "commit": false, "publish": false, "sync": false },
    "git.confirmSync"                             : false,
    "merge-conflict.diffViewPosition"             : "Below",
    "diffEditor.wordWrap"                         : "off",
    "diffEditor.renderSideBySide"                 : true,
    "diffEditor.useInlineViewWhenSpaceIsLimited"  : false,
    "diffEditor.ignoreTrimWhitespace"             : true,
    "diffEditor.maxComputationTime"               : 0,
    "scm.diffDecorationsGutterVisibility"         : "hover",

    // OTHERS
    "markdown.preview.breaks": true,
    "update.mode"                                 : "manual",
    "extensions.ignoreRecommendations"            : true,
    "breadcrumbs.enabled"                         : false,
    "security.workspace.trust.untrustedFiles"     : "open",

    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.wordWrap": "on",
        "editor.occurrencesHighlight": "off",
        "editor.renderLineHighlight": "none",
    },

    "[shellscript]": {
        "editor.matchBrackets": "never",
    },

    // "highlight.regexes": {
    //     "(it|describe|it\\.only|describe\\.only)\\('": {
    //       "regexFlags": "g",
    //       "filterLanguageRegex": "javascript",
    //       "filterFileRegex": ".*Test\\.js",
    //       "decorations": [
    //         { "color": "#C82829", "fontWeight": "bold" },
    //       ]
    //     }
    //   },

    // "highlight.regexes": {
    //     "(when|map|mapValues|pipe)(\\()": {
    //       "filterLanguageRegex": "javascript",
    //       "decorations": [
    //         { "color": "#C82829" },
    //       ]
    //     }
    //   }

    //#endregion

    "copyCodeBlock.formats": [
        {
            "formatName": "default",
            "codeBlockHeaderFormat": "${fullPath}:${topLineNumber}${EOL}",
            "codeBlockFooterFormat": "",
            "codeLineFormat": "${LINENUMBER}: ${CODE}${EOL}",
            "multipleSelectionCreateMultipleCodeBlocks": false,
            "multipleSelectionsBoundalyMarkerFormat": "---${EOL}",
            "forcePathSeparatorSlash": false,
            "forceSpaceIndent": false
        },
        {
            "formatName": "markdown",
            "codeBlockHeaderFormat": "${fullPath}:${topLineNumber}${EOL}${EOL}",
            "codeBlockFooterFormat": "${EOL}",
            "codeLineFormat": "${CODE}${EOL}",
            "multipleSelectionCreateMultipleCodeBlocks": false,
            "multipleSelectionsBoundalyMarkerFormat": "---${EOL}",
            "forcePathSeparatorSlash": true,
            "forceSpaceIndent": true
        }
    ],



    // "inlineFold.regex": "\/\\*\\*(.*)\\*\/",
    "inlineFold.regex": "(\\s*\/\\*\\*[\\s\\S]*?\\*\/)",
    "inlineFold.regexFlags": "g",
    "inlineFold.regexGroup": 1,
    "inlineFold.unfoldedOpacity": 0.6,
    "inlineFold.maskChar": "…",
    "inlineFold.maskColor": "#000",
    "inlineFold.supportedLanguages": ["javascript"],
    "inlineFold.unfoldOnLineSelect": true,
    "inlineFold.autoFold": true,

    "editor.unfoldOnClickAfterEndOfLine": true,
    "editor.foldingImportsByDefault": true,
    "editor.foldingStrategy": "auto",
    "editor.defaultFoldingRangeProvider": "zokugun.explicit-folding",
    "[javascript]": {
        "explicitFolding.perFiles": {
            "*Test.js": {
                // "beginRegex": "^\\s*$",true
                // "begin": "=> {",
                "separator": "=> {",
                // "begin": "it(",
                // "foldLastLine": false,
                // "bypassProtection": true,
                // "consumeEnd": false,
                // "end": "});",
                // "separator": "[it\\(|describe\\(]",
            }
        },
    },
    "explicitFolding.rules": {
        "*": {
            // "separator": "// :"
            "indentation": true,
            "offSide": true
        }
    },

    "[jsonc]": {
        "editor.defaultFormatter": "j-brooke.fracturedjsonvsc"
    },

}
